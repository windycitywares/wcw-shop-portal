# Copy to .env and fill in.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://wcw:wcw@localhost:5432/wcw
# Shared hosting (Passenger): set true so each request opens/closes its own connection
DB_USE_NULL_POOL=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# Used by `python -m app.seed` to create the first admin account
ADMIN_EMAIL=admin@windycitywares.com
ADMIN_PASSWORD=change-me-now

# Product photos: folder on disk + public URL that serves it
MEDIA_ROOT=/home2/windycit/media.windycitywares.com
MEDIA_URL=https://media.windycitywares.com

# Public storefront URL (used for links in emails)
SITE_URL=http://localhost:3000

# Outgoing email. Leave SMTP_HOST empty in development: emails are printed to the log instead.
# HostItBro: mailbox no-reply@windycitywares.com, mail.windycitywares.com port 465 (ssl).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@windycitywares.com
MAIL_FROM_NAME=WindyCityWares
CONTACT_TO=

# Cloudflare Turnstile CAPTCHA (sign-up + contact form). Empty = check skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Stripe test-mode keys, used only while Admin → Test mode is on (no real charges)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Database backups to a PRIVATE GitHub repository (Admin → Backups). Fine-grained token with "Contents: read and
# write" on the backup repository only. Keep the passphrase in your password manager too: without it no backup
# can be restored.
BACKUP_GITHUB_TOKEN=
BACKUP_PASSPHRASE=
# BACKUP_PG_DUMP=/usr/pgsql-13/bin/pg_dump
