# Copy to .env and fill in.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://wcw:wcw@localhost:5432/wcw
# Shared hosting (Passenger): set true so each request opens/closes its own connection
DB_USE_NULL_POOL=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# Used by `python -m app.seed` to create the first admin account
ADMIN_EMAIL=admin@windycitywares.com
ADMIN_PASSWORD=change-me-now
