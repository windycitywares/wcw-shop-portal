# Non-secret production settings (loaded only when ENVIRONMENT=production).
# Secrets (database, JWT, passwords, keys) go in backend/.env on the server, which overrides this file.
SITE_URL=https://shop.windycitywares.com

# Mail goes through the server's own mail system: no mailbox password needed; cPanel signs it (DKIM).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURITY=none
MAIL_FROM=no-reply@windycitywares.com
MAIL_FROM_NAME=WindyCityWares
CONTACT_TO=windycitywaresllc@gmail.com
