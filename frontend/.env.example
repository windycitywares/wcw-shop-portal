# Public URL of this site (used for canonical URLs, sitemap, JSON-LD)
#   while building:  https://shop.windycitywares.com
#   after launch:    https://windycitywares.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Let search engines index the site. Leave false until the store moves to the main domain.
NEXT_PUBLIC_ALLOW_INDEXING=false
# API base URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional: API URL used by the Next.js server (e.g. an internal address)
API_URL=http://localhost:8000/api/v1
# "standalone" (default, Node server) or "export" (static files, no server rendering)
NEXT_OUTPUT=standalone
