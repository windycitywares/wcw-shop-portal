24:T774,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I choose the right size?","acceptedAnswer":{"@type":"Answer","text":"Each product page lists the dimensions of the item, and often a photo for scale. Measure the space you have in mind and compare. If you're unsure, contact us and we'll help you choose."}},{"@type":"Question","name":"Can I add engraving or a personal note?","acceptedAnswer":{"@type":"Answer","text":"Leave a note at checkout with what you'd like, or contact us before ordering. We'll confirm the details with you by email before preparing your order."}},{"@type":"Question","name":"How long does delivery take?","acceptedAnswer":{"@type":"Answer","text":"Most orders are prepared in 1–3 business days and arrive 3–7 business days after shipping. You'll receive an email with tracking as soon as your order ships."}},{"@type":"Question","name":"How can I pay?","acceptedAnswer":{"@type":"Answer","text":"You pay by card on Stripe's secure payment page. We never see or store your card number. If you would rather pay another way, contact us before ordering and we will find something that works."}},{"@type":"Question","name":"Where is my order?","acceptedAnswer":{"@type":"Answer","text":"Use the link in your order confirmation email, or go to Find my order and enter your order number and email address. If you have an account, your orders are listed there too."}},{"@type":"Question","name":"Do you ship outside the United States?","acceptedAnswer":{"@type":"Answer","text":"For now we ship within the United States. If you need delivery elsewhere, contact us and we'll see what we can do."}},{"@type":"Question","name":"Can I use more than one discount code?","acceptedAnswer":{"@type":"Answer","text":"Usually one code per order. Automatic offers and sale prices are applied for you, and the cart always shows the best price."}}]}18:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$24"}}]
