{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next|admin|api|robots\\.txt|sitemap\\.xml|icon\\.svg|favicon\\.ico|.*\\.[\\w]+$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next|admin|api|robots\\.txt|sitemap\\.xml|icon\\.svg|favicon\\.ico|.*\\.[\\w]+$).*)"
        }
      ]
    },
    "/api/live": {}
  }
}